generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  events           Event[]
  eventAttendances EventAttendance[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //
  userAgent String? //
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  roles       Role[]
  memberships Membership[]
  events      Event[]

  @@map("organization")
}

enum Permission {
  CREATE_EVENT
  EDIT_EVENT
  DELETE_EVENT
  MANAGE_MEMBERS
}

model Role {
  orgId       String
  name        String
  permissions Permission[]

  org         Organization @relation(fields: [orgId], references: [id])
  memberships Membership[]

  createdAt DateTime @default(now())

  @@id([orgId, name])
}

model Membership {
  orgId  String
  userId String
  role   Role   @relation(fields: [roleOrgId, roleName], references: [orgId, name])

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  roleName  String
  roleOrgId String

  @@id([orgId, userId])
}

model Event {
  id   String @id @default(cuid())
  name String

  startsAt DateTime
  endsAt   DateTime

  description String?
  location    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  orgId            String
  org              Organization      @relation(fields: [orgId], references: [id])
  eventAttendances EventAttendance[]
}

enum EventStatus {
  ATTENDING
  NOT_ATTENDING
  PENDING
}

model EventAttendance {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status EventStatus @default(PENDING)

  @@id([eventId, userId])
}
